rules_version = '2';

// ============================================================================
// FaceTalk — Firestore Security Rules
// ============================================================================
// This is the single, authoritative rules file for this project (deploy
// with `firebase deploy --only firestore:rules` from this hello-frontend/
// directory). It covers every collection the app writes to: users (+
// friend_requests/following/followers/profileLikes subcollections),
// friendships, moments (+ comments), notifications, reports, chats (+
// messages), voiceRooms, and voiceRoomInvites. Firestore rules are
// deny-by-default outside matched paths, so a new collection needs a match
// block added here before the client can read/write it.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Deterministic friendship doc id used by FriendService: sorted uid pair
    // joined with "_". Mirrors FriendService.getFriendshipDocId.
    function friendshipId(uidA, uidB) {
      return uidA < uidB ? uidA + '_' + uidB : uidB + '_' + uidA;
    }

    function friendshipStatus(uidA, uidB) {
      let path = /databases/$(database)/documents/friendships/$(friendshipId(uidA, uidB));
      return exists(path) ? get(path).data.status : 'none';
    }

    function isFriendOf(otherUid) {
      return isSignedIn() && friendshipStatus(request.auth.uid, otherUid) == 'friends';
    }

    function isBlockedBy(otherUid) {
      return isSignedIn() && friendshipStatus(request.auth.uid, otherUid) == 'blocked';
    }

    // ------------------------------------------------------------------
    // users/{uid} — profile documents. Full read for any signed-in user
    // (needed across the app: avatars, names, the friend/block checks
    // above); only the profile owner may write their own document.
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // ----------------------------------------------------------------
      // users/{uid}/friend_requests/{requestId} — written under the
      // RECIPIENT's uid (`uid` here) by the SENDER (`fromUserId`) — see
      // FriendService.sendFriendRequest/cancelRequest. Both sides need
      // some access: the recipient to read/accept/decline their inbox,
      // the sender to write the initial request and cancel it later.
      // ------------------------------------------------------------------
      match /friend_requests/{requestId} {
        allow read: if isOwner(uid);

        // Without checking fromUserId here, any signed-in user could drop
        // a friend_requests doc into ANY user's inbox claiming to be from
        // someone else (spoofing who the request is "from").
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.fromUserId;

        allow update: if isOwner(uid);

        // The recipient can delete when declining; the original sender
        // needs this too for "cancel" (FriendService.cancelRequest) —
        // restricting delete to just the recipient silently breaks
        // canceling an outgoing request (the whole batch, including the
        // friendships doc update, fails since batches are all-or-nothing).
        allow delete: if isOwner(uid) ||
          (resource != null && request.auth.uid == resource.data.fromUserId);
      }

      // ------------------------------------------------------------------
      // users/{uid}/following/{targetUid} — exists iff `uid` follows
      // `targetUid`. Only the follower (`uid` here) manages their own
      // following list — see FollowService.follow/unfollow, which writes
      // this and the mirroring followers/ doc below in one batch.
      // ------------------------------------------------------------------
      match /following/{targetUid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }

      // ------------------------------------------------------------------
      // users/{uid}/followers/{followerUid} — the mirror image, written
      // under the person being followed (`uid`) by the follower
      // (`followerUid`) — same "written under the other party" shape as
      // friend_requests above, with the same spoofing check.
      // ------------------------------------------------------------------
      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == followerUid;
        allow update: if false;
      }

      // ------------------------------------------------------------------
      // users/{uid}/profileLikes/{likerUid} — the thumbs-up "like" button
      // on partner_profile_screen.dart, exists iff likerUid liked uid's
      // profile. Same "written under the other party" shape as followers/
      // above — see ProfileLikeService.
      // ------------------------------------------------------------------
      match /profileLikes/{likerUid} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn() && request.auth.uid == likerUid;
        allow update: if false;
      }
    }

    // ------------------------------------------------------------------
    // friendships/{docId} — only the two participants involved may read
    // or write. Doc id is always friendshipId(uidA, uidB); we don't have
    // the two uids split out here so we check membership via `userIds`.
    // ------------------------------------------------------------------
    match /friendships/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.userIds;
    }

    // ------------------------------------------------------------------
    // moments/{postId}
    // ------------------------------------------------------------------
    match /moments/{postId} {

      function isPostOwner() {
        return isSignedIn() && resource.data.user.id == request.auth.uid;
      }

      // `audience` is a denormalized "who may read this post" list —
      // 'public' for public posts, [ownerUid] for onlyMe, and
      // [ownerUid, ...friendUidsAtPostTime] for friends — computed
      // client-side at write time (see MomentService._audienceFor).
      //
      // It has to be a stored, queryable field rather than a live
      // isFriendOf() lookup here: Cloud Firestore validates a *list* query
      // (the feed) against its own filters, checking whether every document
      // the query could structurally return would satisfy this rule — not
      // against the documents it actually returns. A condition like
      // isFriendOf(resource.data.user.id) has no corresponding query filter,
      // so a query without one gets rejected outright with
      // permission-denied, regardless of what's really in the collection.
      // `audience.hasAny([...])` paired with MomentService's matching
      // `.where('audience', arrayContainsAny: [...])` filter is the pattern
      // Firestore can actually prove compliant.
      function visibleToMe() {
        return resource.data.isDeleted == false &&
          (resource.data.audience.hasAny(['public', request.auth.uid]) || isPostOwner());
      }

      function validAudience(data) {
        return data.audience is list &&
          (
            (data.visibility == 'public' && data.audience.hasAny(['public'])) ||
            (data.visibility != 'public' && request.auth.uid in data.audience)
          );
      }

      allow read: if isSignedIn() && visibleToMe();

      allow create: if isSignedIn() &&
        request.resource.data.user.id == request.auth.uid &&
        request.resource.data.isDeleted == false &&
        validAudience(request.resource.data);

      allow update: if isSignedIn() && (
        // Post owner can edit/archive/delete their own post
        (
          isPostOwner() &&
          request.resource.data.user.id == resource.data.user.id &&
          request.resource.data.createdAt == resource.data.createdAt
        ) ||
        // Any signed-in non-blocked user can toggle likes/reactions or increment comment/reshare counts
        (
          !isBlockedBy(resource.data.user.id) &&
          request.resource.data.user.id == resource.data.user.id &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.isDeleted == resource.data.isDeleted
        )
      );

      // Never hard-delete from the client — soft delete via `isDeleted` is
      // an update, handled above. functions/index.js's onPostDelete only
      // runs for an actual Admin-SDK/console hard delete.
      allow delete: if false;

      match /comments/{commentId} {
        function postOwnerId() {
          return get(/databases/$(database)/documents/moments/$(postId)).data.user.id;
        }

        allow read: if isSignedIn();

        allow create: if isSignedIn() &&
          request.resource.data.userId == request.auth.uid &&
          !isBlockedBy(postOwnerId());

        // No editing — comments are create/delete only.
        allow update: if false;

        allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // ------------------------------------------------------------------
    // notifications/{uid}/items/{notifId} — owner-only. In practice these
    // are written by Cloud Functions (Admin SDK bypasses rules); the client
    // rule below only needs to cover the owner marking their own items read.
    // ------------------------------------------------------------------
    match /notifications/{uid}/items/{notifId} {
      allow read, write: if isOwner(uid);
    }

    // ------------------------------------------------------------------
    // reports/{reportId} — any signed-in user may file one about someone
    // else's post; only admins (users/{uid}.role == 'admin') may read them.
    // ------------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.reason in ['spam', 'inappropriate', 'harassment', 'other'];
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // chats/{chatId} and chats/{chatId}/messages/{messageId}
    //
    // Previously `allow create, update: if isSignedIn()` with no ownership
    // check at all — ANY signed-in user could read, create, or overwrite
    // ANY other pair's chat thread (messages included), since chatId is
    // deterministic (ChatService.chatIdFor: sorted uids joined with "_")
    // and therefore guessable/computable from two known uids. Fixed to
    // require the caller be one of the thread's two participants, and to
    // tie chatId itself to those participants so a doc can't be written
    // under someone else's chatId by supplying a fake `participants` list
    // client-side (which client code otherwise fully controls).
    // ------------------------------------------------------------------
    match /chats/{chatId} {
      function idMatchesParticipants(participants) {
        return participants is list && participants.size() == 2 &&
          chatId == (participants[0] < participants[1]
            ? participants[0] + '_' + participants[1]
            : participants[1] + '_' + participants[0]);
      }

      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        idMatchesParticipants(request.resource.data.participants);

      // Participants never change after creation — only per-message fields
      // (lastMessage, unread.*, participantInfo) do — see ChatService.
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        // Each message also carries its own `participants` snapshot (see
        // ChatService.sendMessage) so this rule never needs a get() on the
        // parent doc — which would silently fail closed for the very first
        // message of a brand-new thread, since get() inside a batched write
        // only ever sees the pre-commit state, not sibling writes in the
        // same batch. `idMatchesParticipants` still ties that snapshot back
        // to the real chatId, so it can't be spoofed.
        allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

        // Blocks a reply into a broadcast/announcement thread (admin panel
        // -> hello-backend's FirestoreChatBroadcastService, which sets
        // isReadOnly: true on the parent chat doc — see ChatService.
        // systemUid on the Flutter side, which hides the composer for the
        // same reason but doesn't stop a hand-crafted write without this).
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in request.resource.data.participants &&
          idMatchesParticipants(request.resource.data.participants) &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.get('isReadOnly', false) == false;

        allow update, delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // voiceRooms/{roomId} — a user's live/active voice room. Every room the
    // app creates today is public (there is no private-room option in the
    // UI). `audience` is a denormalized "who may read this room" list —
    // always `['public']` for a room created now — same pattern as
    // moments/{postId}.audience above and for the same reason (a list query
    // needs a matching filter to be provably rule-compliant; see
    // lib/services/voice_room_service.dart's _audienceKeysForReader). The
    // rules below still also accept a restricted, non-'public' audience
    // list purely so any room document written before rooms went
    // public-only keeps working unchanged. "Ending" a room is a soft update
    // (isActive: false), never a delete — see voice_room_service.dart.
    // ------------------------------------------------------------------
    match /voiceRooms/{roomId} {
      // `!('audience' in resource.data)` keeps any room document written
      // before this field existed publicly readable (fail-open to the old
      // behavior) rather than erroring on a missing map key — every room
      // created from here on always gets one (see the create rule below).
      function isInAudience() {
        return !('audience' in resource.data) ||
          resource.data.audience.hasAny(['public', request.auth.uid]);
      }

      // Used by the participants/comments/whiteboard subcollections below:
      // a room's own audience list gates access to everything inside it
      // too, not just the room doc itself, otherwise a private room's
      // roster/chat/whiteboard would stay readable by anyone who somehow
      // learns its roomId even once they can no longer see the room doc.
      function canAccessRoom(rid) {
        let room = get(/databases/$(database)/documents/voiceRooms/$(rid)).data;
        return !('audience' in room) || room.audience.hasAny(['public', request.auth.uid]);
      }

      allow read: if isSignedIn() && isInAudience();

      // The app always creates `audience: ['public']`. The second branch
      // (own uid in audience) is only kept so a restricted-audience create
      // — which the current UI never issues — would still at least include
      // its own host rather than lock them out of a room the instant it's
      // created (isInAudience() above wouldn't otherwise match their uid).
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid &&
        request.resource.data.audience is list &&
        (request.resource.data.audience.hasAny(['public']) ||
          request.auth.uid in request.resource.data.audience);

      // Three distinct writers: the host, who may change anything except
      // hostId/createdAt; any signed-in participant, who may only adjust
      // participantCount (RoomParticipantService.join/leave bumping it as
      // people come and go); and a live moderator, who may only flip
      // isActive (ending the room — see VoiceRoomService.endRoom — so a
      // room can still be closed once its original host has left, per the
      // Host -> Moderator handoff).
      allow update: if isSignedIn() && (
        (resource.data.hostId == request.auth.uid &&
          request.resource.data.hostId == resource.data.hostId &&
          request.resource.data.createdAt == resource.data.createdAt) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount']) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive']) &&
          get(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(request.auth.uid)).data.role == 'moderator')
      );

      allow delete: if false;

      // ------------------------------------------------------------------
      // participants/{uid} — who's actually present in this room right now
      // and their seat/mute state (RoomParticipantService). Replaces the
      // old boardSpeakers/boardComments mock data in the room screen.
      // Readable (the live speaker grid) by anyone already in the parent
      // room's audience — see canAccessRoom() above. On create,
      // a user may only claim 'host' if they really are this room's host
      // (per voiceRooms/{roomId}.hostId), otherwise they join as
      // 'listener' — never 'moderator' or 'speaker' straight out of the
      // gate. On update, a self-write may leave `role` untouched (mic
      // mute/etc.) or move it between 'listener'/'speaker'
      // (requestToSpeak), but never self-promote to 'moderator' or 'host';
      // the room's host may change any other participant's doc freely
      // (removeFromStage, promoteToModerator); a live moderator may only
      // demote someone else back to 'listener' (removeFromStage) — never
      // promote anyone to moderator themselves.
      // ------------------------------------------------------------------
      match /participants/{uid} {
        allow read: if isSignedIn() && canAccessRoom(roomId);
        // canAccessRoom(roomId) is what actually stops a random signed-in
        // user from joining (creating a participant doc in) a private room
        // they were never invited to — the host/listener branches below
        // only ever governed which *role* a join could claim, not whether
        // the room itself was joinable at all.
        allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.uid == uid &&
          canAccessRoom(roomId) &&
          ((request.resource.data.role == 'host' &&
              get(/databases/$(database)/documents/voiceRooms/$(roomId)).data.hostId == request.auth.uid) ||
            (request.resource.data.role == 'listener' &&
              get(/databases/$(database)/documents/voiceRooms/$(roomId)).data.hostId != request.auth.uid));
        allow update: if isSignedIn() &&
          ((request.auth.uid == uid &&
              (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
                request.resource.data.role in ['listener', 'speaker'])) ||
            get(/databases/$(database)/documents/voiceRooms/$(roomId)).data.hostId == request.auth.uid ||
            (get(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(request.auth.uid)).data.role == 'moderator' &&
              request.resource.data.role == 'listener'));
        // Self-delete (leaving normally) always works. Anyone else
        // signed in may also delete a participant doc whose own
        // heartbeat (lastActiveAt — RoomParticipantService.heartbeat)
        // has gone stale for 90s+ — this is what lets any client in the
        // room act as a decentralized janitor for someone who
        // disconnected without a clean leave() (closed tab, crashed,
        // lost network), since this project has no server-side sweep.
        // The 90s threshold is server-time-authoritative here, so a
        // client can never evict someone who's actually still sending
        // heartbeats, regardless of what it claims client-side.
        allow delete: if isSignedIn() &&
          (request.auth.uid == uid ||
            (resource.data.lastActiveAt is timestamp &&
              request.time > resource.data.lastActiveAt + duration.value(90, 's')));
      }

      // ------------------------------------------------------------------
      // comments/{commentId} — the room board's live comment feed. Anyone
      // in the parent room's audience can read (see canAccessRoom() above),
      // but only a current stage participant (host, moderator, or speaker —
      // never a queued listener) can post; never edited or deleted once
      // sent.
      // ------------------------------------------------------------------
      match /comments/{commentId} {
        allow read: if isSignedIn() && canAccessRoom(roomId);
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid &&
          get(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(request.auth.uid)).data.role in ['host', 'moderator', 'speaker'];
        allow update, delete: if false;
      }

      // ------------------------------------------------------------------
      // whiteboard/{itemId} — shared images/text notes on the room's stage
      // card (WhiteboardService). Anyone in the parent room's audience can
      // view (see canAccessRoom() above); only the room's host or a live
      // moderator can add, edit, or remove items.
      // ------------------------------------------------------------------
      match /whiteboard/{itemId} {
        allow read: if isSignedIn() && canAccessRoom(roomId);
        allow create, update, delete: if isSignedIn() &&
          get(/databases/$(database)/documents/voiceRooms/$(roomId)/participants/$(request.auth.uid)).data.role in ['host', 'moderator'];
      }
    }

    // ------------------------------------------------------------------
    // voiceRoomInvites/{inviteId} — a host inviting one specific friend to
    // their live room. This is a client-writable trigger doc only, not the
    // notification itself: functions/index.js's onVoiceRoomInviteCreate
    // turns it into a real notifications/{recipientId}/items entry (Admin
    // SDK, bypasses rules) — a client can never write directly into
    // someone else's notification feed, matching every other notification
    // type in this app.
    // ------------------------------------------------------------------
    match /voiceRoomInvites/{inviteId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.hostId || request.auth.uid == resource.data.recipientId);
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}

